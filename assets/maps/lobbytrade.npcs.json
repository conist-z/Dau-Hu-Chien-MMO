  "dialogues": {
    "cho_den_intro": {
      "text": "Chợ đen — mọi giao dịch đều ở đây. Nơi này cấm phá/block, cứ yên tâm buôn bán.",
      "options": [
        {"label": "Được thôi, thôi xong", "next": null, "effect": {}}
      ]
    },
    "thong_bao_intro": {
      "text": "📌 BẢNG THÔNG BÁO — Chào mừng đến khu trao đổi! Dùng /khutraodoi out để quay về. Cấm phá block trong chợ. Quái không vào được đây.",
      "options": [
        {"label": "Đã đọc", "next": null, "effect": {}}
      ]
    },
    "thien_than_intro": {
      "text": "Tượng thiên thần lặng lẽ canh chừng khu trao đổi… như thể đang chờ ai đó.",
      "options": [
        {"label": "(Cầu nguyện)", "next": null, "effect": {}}
      ]
    },
    "cua_nha_intro": {
      "text": "Cửa ngôi nhà cũ — khóa rồi, bên trong dường như đã lâu không ai ra vào.",
      "options": [
        {"label": "Đi tiếp", "next": null, "effect": {}}
      ]
    },
    "cua_ruou_intro": {
      "text": "Quán rượu — mùi bia nồng nặc thoang thoảng qua khe cửa.",
      "options": [
        {"label": "Đi tiếp", "next": null, "effect": {}}
      ]
    }
